{
  "name": "fandex-scripts",
  "version": "1.11.1",
  "private": true,
  "description": "番剧收藏册 PDF 管线脚本（先 npm i；再改 config.json 的 root；然后 npm run pipeline）",
  "scripts": {
    "subset": "node collect_fonts.js",
    "base": "node names_to_base.js",
    "build": "node build_anime_html.js",
    "render": "node render_pw.js",
    "map": "node anime_pagemap.js",
    "pipeline": "node collect_fonts.js && node build_anime_html.js && node render_pw.js && node anime_pagemap.js && node build_anime_html.js && node render_pw.js && node anime_pagemap.js",
    "sheet": "node contact_sheet.js",
    "cards": "node export_cards.js",
    "candidates": "node fetch_candidates.js",
    "check": "node ../evals/pdfprobe.js && node ../evals/check.js",
    "probe": "node ../evals/pdfprobe.js",
    "audit": "node ../evals/audit.js",
    "lint": "node ../evals/lint_skill.js",
    "doctor": "node doctor.js",
    "sources": "node sources.js",
    "epub": "node epub.js",
    "userdata": "node migrate_userdata.js",
    "userdata:set": "node set_userdata.js",
    "userdata:list": "node set_userdata.js --list",
    "test:userdata": "node ../evals/test_userdata.js",
    "pack": "node pack.js",
    "version:check": "node sync_version.js --check",
    "version:fix": "node sync_version.js --fix"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.49.0"
  }
}
